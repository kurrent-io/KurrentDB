# Copy to .env and fill in. .env is gitignored.

# Required: a license key with the MULTI_NODE_CLUSTER entitlement.
# NOTE: do not rename this to KURRENTDB_*; the server would parse it as an unknown option.
KDB_LICENSE_KEY=

RUNTIME=linux-x64

# --- Run shape -------------------------------------------------------------------------------
DURATION_SECONDS=1800
WRITER_COUNT=1

# --- Writer load -----------------------------------------------------------------------------
# Concurrency, not rate, is what puts appends in flight at the moment a leader is replaced.
CONCURRENCY=32
STREAMS_PER_TASK=4
EVENT_SIZE_BYTES=128
ESDB_CONNECTION=esdb://admin:changeit@node1.eventstore:2113,node2.eventstore:2113,node3.eventstore:2113?tls=true&tlsVerifyCert=false

# --- Checker ---------------------------------------------------------------------------------
NODES=node1=node1.eventstore:2113,node2=node2.eventstore:2113,node3=node3.eventstore:2113
SCHEME=https
KDB_USER=admin
KDB_PASSWORD=changeit
LOGS_DIR=/logs
LEDGER_DIR=/ledger

# Pumba cannot resign a leader - that is an application operation, so the checker does it.
# Set to 0 to disable and test crash/hang only.
RESIGN_INTERVAL_SECONDS=45

# Liveness budgets. Some leaderless time is expected; these bound it.
MAX_LEADERLESS_PERCENT=15
MAX_SINGLE_OUTAGE_SECONDS=45
STARTUP_TIMEOUT_SECONDS=180
SETTLE_TIMEOUT_SECONDS=120

# Slow queues are a real signal under steady load but fire constantly under deliberate overload.
ENFORCE_SLOW_QUEUE=true

# --- Chaos -----------------------------------------------------------------------------------
CHAOS_CRASH_INTERVAL=90s
CHAOS_HANG_INTERVAL=150s
CHAOS_HANG_DURATION=20s

# How long verification may spend reading streams back before giving up.
VERIFY_TIMEOUT_SECONDS=300

# --- Aggressive profile -----------------------------------------------------------------------
# Swap these in for a harder run. Faults roughly double in frequency and the freeze is long enough
# to comfortably outlast KontrolPlaneAppointmentTimeoutMs, which is what forces the Kontrol Plane
# to fence a leader that has gone quiet rather than crashed.
#
# Two nodes being impaired at once stops being rare at this rate, and on a three-node cluster that
# is quorum loss. That is deliberate - it exercises the cluster refusing to commit and then
# recovering - but it means the LIVENESS budgets will be breached regularly and are no longer the
# interesting signal. The safety invariants stay strict: S1-S6 must hold no matter how hard the
# cluster is hit, and S4 in particular is the one worth watching.
#
# CHAOS_CRASH_INTERVAL=45s
# CHAOS_HANG_INTERVAL=70s
# CHAOS_HANG_DURATION=25s
# RESIGN_INTERVAL_SECONDS=25
# CONCURRENCY=64
# WRITER_COUNT=2
# MAX_LEADERLESS_PERCENT=35
# MAX_SINGLE_OUTAGE_SECONDS=60
# ENFORCE_SLOW_QUEUE=false
