{
	"ParallelLimit": -1, // -1 limits to Environment.ProcessorCount
	"Node": {
		"Insecure": false,
		"Username": "admin",
		"Password": "changeit", // or via env NODE__PASSWORD
		"NodeType": "embedded", // container, embedded, external
		"Container": {
			"CleanUp": true,
			"Registry": "docker.kurrent.io/kurrent-latest",
			"Repository": "kurrentdb",
			"Tag": "25.1.0"
		},
		// Paths are relative to the test output directory. The build copies the repo-root
		// certs/ tree there, so the same values resolve on every OS. Generate the certs with
		// "docker compose run --rm cert-gen" from the repo root.
		"Embedded": {
			"TrustedRootCertificatesPath": "certs/ca",
			"CertificateFile": "certs/node3/node.crt",
			"CertificatePrivateKeyFile": "certs/node3/node.key"
		},
		"External": {
			"Host": "localhost",
			"Port": 2113
		}
	},
	"ExpectedVersion": "" // set this to specify an expected version prefix
}
