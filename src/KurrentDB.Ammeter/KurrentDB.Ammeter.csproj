<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsKurrentTUnit>true</IsKurrentTUnit>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="RestSharp" />
		<PackageReference Include="Testcontainers" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\KurrentDB.Api.V2.Tests\KurrentDB.Api.V2.Tests.csproj" />
		<ProjectReference Include="..\KurrentDB.Core.TUnit.Tests\KurrentDB.Core.TUnit.Tests.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- The embedded node needs the cluster certificates beside the test binaries so the paths in
	     appsettings.json stay relative and resolve the same on every machine. The certs are
	     generated by the cert-gen compose service, not committed, so the glob is empty until they
	     exist and the build stays green without them. -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)../../certs/**/*"
		      LinkBase="certs"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
