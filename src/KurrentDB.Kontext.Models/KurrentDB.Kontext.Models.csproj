<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Pre-bundled ONNX models for KurrentDB.Kontext (all-MiniLM-L6-v2, ms-marco-TinyBERT-L2-v2, paraphrase-multilingual-MiniLM-L12-v2). Models are embedded as assembly resources.</Description>
    <KontextModelsDir>$(MSBuildThisFileDirectory)</KontextModelsDir>
    <!-- The MiniLM embedding and TinyBERT cross-encoder bundles exist ONLY for the prototype's
         AddLocalEmbeddings/CrossEncoderService path; the new system ships pmm12 alone. Overridable:
         -p:KontextIncludePrototypeModels=false skips their download AND their embedding in one
         switch (they must move together - an EmbeddedResource pointing at a never-downloaded file
         fails the build). Flip the default to false when the prototype retires. -->
    <KontextIncludePrototypeModels Condition="'$(KontextIncludePrototypeModels)' == ''">true</KontextIncludePrototypeModels>
    <!-- gliner_small-v2.1 int8 is the zero-shot NER model behind entity extraction, loaded by
         AddKontextEntities. Downloaded AND embedded, like pmm12: the download only puts the file
         where the embed can reach it. -p:KontextIncludeGliner=false skips both together (an
         EmbeddedResource pointing at a never-downloaded file fails the build). The on-disk layout
         is the one OnnxModelRegistry expects — <key>/onnx/<model> and <key>/<asset>, keyed by
         GlinerOnnxEntityRecognizer.DefaultModelId — so a registry can still be pointed here.

         This project carries what Kontext needs to RUN, and nothing else. Models used only by a
         test or a benchmark are downloaded by that project when it runs, so a build never pays
         for a comparison nobody asked for. -->
    <KontextIncludeGliner Condition="'$(KontextIncludeGliner)' == ''">true</KontextIncludeGliner>
    <KontextGlinerDir>$(KontextModelsDir)gliner-small-v2.1/</KontextGlinerDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(KontextIncludePrototypeModels)' == 'true'">
    <EmbeddedResource Include="embedding/model_quint8_avx2.onnx" LogicalName="KurrentDB.Kontext.Models.embedding.model_quint8_avx2.onnx" />
    <EmbeddedResource Include="embedding/model_qint8_avx512.onnx" LogicalName="KurrentDB.Kontext.Models.embedding.model_qint8_avx512.onnx" />
    <EmbeddedResource Include="embedding/vocab.txt" LogicalName="KurrentDB.Kontext.Models.embedding.vocab.txt" />
    <EmbeddedResource Include="cross-encoder/model_quint8_avx2.onnx" LogicalName="KurrentDB.Kontext.Models.cross-encoder.model_quint8_avx2.onnx" />
    <EmbeddedResource Include="cross-encoder/model_qint8_avx512.onnx" LogicalName="KurrentDB.Kontext.Models.cross-encoder.model_qint8_avx512.onnx" />
    <EmbeddedResource Include="cross-encoder/vocab.txt" LogicalName="KurrentDB.Kontext.Models.cross-encoder.vocab.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interim multilingual model (paraphrase-multilingual-MiniLM-L12-v2). Physical file keeps its HF name
         (model_quantized.onnx); the LogicalName is the stable string FromEmbeddedResources looks up. The
         tokenizer is the shared XLM-R sentencepiece.bpe.model, same file the Playground fetches from e5. -->
    <EmbeddedResource Include="pmm12/model_quantized.onnx" LogicalName="KurrentDB.Kontext.Models.pmm12.model.onnx" />
    <EmbeddedResource Include="pmm12/sentencepiece.bpe.model" LogicalName="KurrentDB.Kontext.Models.pmm12.sentencepiece.bpe.model" />
  </ItemGroup>

  <!-- The models directory is this directory. The download targets below fill it and nothing copies
       out of it: a Content item would ride every ProjectReference in the graph and land a 175MB file
       in the output of every project that transitively sees this one. Consumers read it through
       OnnxModelRegistry, which resolves <key>/onnx/<model> and <key>/<asset> under the path below. -->
  <!-- Download the go-live bundle before build if missing.
       paraphrase-multilingual-MiniLM-L12-v2: quantized ONNX + the shared XLM-R SentencePiece tokenizer
       (the same sentencepiece.bpe.model published under intfloat/multilingual-e5-small). Interim only,
       until the HuggingFace.ModelDownloader lands. -->
  <Target Name="DownloadPmm12IfMissing" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(KontextModelsDir)pmm12/model_quantized.onnx') Or !Exists('$(KontextModelsDir)pmm12/sentencepiece.bpe.model')">

    <Message Importance="high" Text="Downloading pmm12 ONNX model (first build only)..." />

    <MakeDir Directories="$(KontextModelsDir)pmm12" />

    <DownloadFile
      SourceUrl="https://huggingface.co/Xenova/paraphrase-multilingual-MiniLM-L12-v2/resolve/main/onnx/model_quantized.onnx"
      DestinationFolder="$(KontextModelsDir)pmm12"
      Condition="!Exists('$(KontextModelsDir)pmm12/model_quantized.onnx')" />

    <DownloadFile
      SourceUrl="https://huggingface.co/intfloat/multilingual-e5-small/resolve/main/sentencepiece.bpe.model"
      DestinationFolder="$(KontextModelsDir)pmm12"
      Condition="!Exists('$(KontextModelsDir)pmm12/sentencepiece.bpe.model')" />

    <Message Importance="high" Text="pmm12 ONNX model downloaded successfully." />
  </Target>


  <!-- Download the GLiNER zero-shot NER bundle before build if missing. -->
  <Target Name="DownloadGlinerIfMissing" BeforeTargets="PrepareForBuild"
          Condition="'$(KontextIncludeGliner)' == 'true' And (!Exists('$(KontextGlinerDir)onnx/model_quantized.onnx') Or !Exists('$(KontextGlinerDir)spm.model'))">

    <Message Importance="high" Text="Downloading gliner_small-v2.1 ONNX model (~177MB, first build only)..." />

    <MakeDir Directories="$(KontextGlinerDir)onnx" />

    <DownloadFile
      SourceUrl="https://huggingface.co/onnx-community/gliner_small-v2.1/resolve/main/onnx/model_quantized.onnx"
      DestinationFolder="$(KontextGlinerDir)onnx"
      Condition="!Exists('$(KontextGlinerDir)onnx/model_quantized.onnx')" />

    <DownloadFile
      SourceUrl="https://huggingface.co/onnx-community/gliner_small-v2.1/resolve/main/spm.model"
      DestinationFolder="$(KontextGlinerDir)"
      Condition="!Exists('$(KontextGlinerDir)spm.model')" />

    <Message Importance="high" Text="gliner_small-v2.1 ONNX model downloaded successfully." />
  </Target>


  <!-- Download the prototype-only bundles before build if missing - gated with their embeds. -->
  <Target Name="DownloadPrototypeModelsIfMissing" BeforeTargets="PrepareForBuild"
          Condition="'$(KontextIncludePrototypeModels)' == 'true' And (!Exists('$(KontextModelsDir)embedding/model_quint8_avx2.onnx') Or !Exists('$(KontextModelsDir)cross-encoder/model_quint8_avx2.onnx'))">

    <Message Importance="high" Text="Downloading prototype ONNX models (first build only)..." />

    <MakeDir Directories="$(KontextModelsDir)embedding" />
    <MakeDir Directories="$(KontextModelsDir)cross-encoder" />

    <DownloadFile
      SourceUrl="https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main/onnx/model_quint8_avx2.onnx"
      DestinationFolder="$(KontextModelsDir)embedding"
      Condition="!Exists('$(KontextModelsDir)embedding/model_quint8_avx2.onnx')" />

    <DownloadFile
      SourceUrl="https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main/onnx/model_qint8_avx512.onnx"
      DestinationFolder="$(KontextModelsDir)embedding"
      Condition="!Exists('$(KontextModelsDir)embedding/model_qint8_avx512.onnx')" />

    <DownloadFile
      SourceUrl="https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main/vocab.txt"
      DestinationFolder="$(KontextModelsDir)embedding"
      Condition="!Exists('$(KontextModelsDir)embedding/vocab.txt')" />

    <DownloadFile
      SourceUrl="https://huggingface.co/cross-encoder/ms-marco-TinyBERT-L2-v2/resolve/main/onnx/model_quint8_avx2.onnx"
      DestinationFolder="$(KontextModelsDir)cross-encoder"
      Condition="!Exists('$(KontextModelsDir)cross-encoder/model_quint8_avx2.onnx')" />

    <DownloadFile
      SourceUrl="https://huggingface.co/cross-encoder/ms-marco-TinyBERT-L2-v2/resolve/main/onnx/model_qint8_avx512.onnx"
      DestinationFolder="$(KontextModelsDir)cross-encoder"
      Condition="!Exists('$(KontextModelsDir)cross-encoder/model_qint8_avx512.onnx')" />

    <DownloadFile
      SourceUrl="https://huggingface.co/cross-encoder/ms-marco-TinyBERT-L2-v2/resolve/main/vocab.txt"
      DestinationFolder="$(KontextModelsDir)cross-encoder"
      Condition="!Exists('$(KontextModelsDir)cross-encoder/vocab.txt')" />

    <Message Importance="high" Text="Prototype ONNX models downloaded successfully." />
  </Target>

</Project>
