<Project>
  <!--
    Hard link large assets into every output directory instead of copying them. The repo carries
    several hundred-megabyte binaries — the vendored lance extension, the embedded ONNX models,
    the DuckDB and ONNX natives — and MSBuild copies each one into the output of every project
    that references it, directly or transitively. Linking makes those directory entries share a
    single file on disk, so the bytes are written once no matter how many projects consume them.

    Three properties because three different Copy invocations are involved: content and None
    items, copy-local references, and the project's own build outputs.

    Hard links need the source and the destination on one volume; MSBuild falls back to copying
    when they are not, so a build on a separate output disk still works, just without the saving.
  -->
  <PropertyGroup>
    <CreateHardLinksForAdditionalFilesIfPossible>true</CreateHardLinksForAdditionalFilesIfPossible>
    <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
    <CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>true</CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>
  </PropertyGroup>

  <PropertyGroup>
    <!-- This file sits one level below the repository root, and it is the nearest
         Directory.Build.props for everything under src, so it is where a project reaching outside
         its own cone can anchor. -->
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</RepoRoot>
  </PropertyGroup>

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <DebugType Condition=" '$(Configuration)' == 'Debug' ">full</DebugType>
    <DebugType Condition=" '$(Configuration)' == 'Release' ">pdbonly</DebugType>
    <Authors>Kurrent, Inc</Authors>
    <PackageIconUrl>ouro.png</PackageIconUrl>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://kurrent.io</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright 2011-2026 Kurrent, Inc</Copyright>
    <PackageReleaseNotes>https://docs.kurrent.io/server/latest/release-schedule/release-notes</PackageReleaseNotes>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <IsPackable>false</IsPackable>
    <VersionPrefix>26.2.0</VersionPrefix>
    <VersionSuffix>prerelease</VersionSuffix>
    <!-- Adjust for SYSLIB0057 separately to .NET 10 upgrade -->
    <!-- Adjust for XUNIT1051 separately. Lots of lines but very simple -->
    <NoWarn>SYSLIB0057;xUnit1051</NoWarn><TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- DisableCiTestRsp is set (via environment variable) by scripts/testing/test-runner.cs for
         all its invocations: the runner supplies its own TRX reporting and timeouts, coverage and
         hangdump are CI-only concerns, and ci.rsp's &#45;&#45;report-trx breaks TUnit's
         &#45;&#45;list-tests discovery. CI invokes dotnet test directly (variable unset) and is
         unaffected. -->
    <TestingPlatformCommandLineArguments Condition="'$(DisableCiTestRsp)' != 'true'">$(TestingPlatformCommandLineArguments) @"$(MSBuildThisFileDirectory)../ci/ci.rsp"</TestingPlatformCommandLineArguments>
    <!-- we put these two here and not only for explicitly labelled test projects to make sure that -->
    <!-- we don't accidentally mix MTP with VSTest, which is not supported -->
    <!-- tell xunit projects to use MTP -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- tell nunit projects to use MTP -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <!-- TUnit -->
  <ItemGroup Condition="'$(IsKurrentTUnit)' == 'True'">
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!-- XUnit -->
  <ItemGroup Condition="'$(IsKurrentXUnit)' == 'True'">
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <!-- NUnit -->
  <PropertyGroup Condition="'$(IsKurrentNUnit)' == 'True'">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --settings $(MSBuildThisFileDirectory)../ci/ci.runsettings</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsKurrentNUnit)' == 'True'">
    <!--
    Microsoft.NET.Test.Sdk is not required with MTP, but Rider can't locate tests without it.
    See https://youtrack.jetbrains.com/projects/RIDER/issues/RIDER-131530
    -->
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <!-- All test projects -->
  <ItemGroup Condition="'$(IsKurrentTUnit)' == 'True' Or '$(IsKurrentXUnit)' == 'True' Or '$(IsKurrentNUnit)' == 'True'">
    <PackageReference Include="Microsoft.Testing.Platform" />
		<PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPlugin)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)\KurrentDB.Plugins\KurrentDB.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPluginsTestProject)' == 'true'">
    <ProjectReference Include="..\KurrentDB.Plugins.TestHelpers\KurrentDB.Plugins.TestHelpers.csproj" />
  </ItemGroup>

	<ItemGroup Label="Default Packages">
		<PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
		<Using Include="JetBrains.Annotations" />
	</ItemGroup>
</Project>
