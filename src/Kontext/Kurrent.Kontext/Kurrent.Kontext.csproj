<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\KurrentDB.Core\KurrentDB.Core.csproj" />
    <ProjectReference Include="..\..\KurrentDB.Surge\KurrentDB.Surge.csproj" />
    <ProjectReference Include="..\Kurrent.Kontext.Contracts\Kurrent.Kontext.Contracts.csproj" />
    <ProjectReference Include="..\Kurrent.Kontext.DuckLance\DuckLance.csproj" />
    <ProjectReference Include="..\Kurrent.Kontext.Embeddings\Kurrent.Kontext.Embeddings.csproj" />
    <ProjectReference Include="..\Kurrent.Kontext.Retrieval\Kurrent.Kontext.Retrieval.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Kontext.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNext.Threading" />
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Kurrent.Quack" />
    <PackageReference Include="Kurrent.Surge.Core" />
    <PackageReference Include="Kurrent.Surge.DuckDB" />
    <!-- Surge pulls System.Linq.Async transitively; net10's built-in System.Linq.AsyncEnumerable
         makes its operators ambiguous at compile time, so compile assets are excluded — the
         repo-wide remedy (see KurrentDB.Surge.csproj). -->
    <PackageReference Include="System.Linq.Async">
      <ExcludeAssets>compile</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="ModelContextProtocol"/>
    <PackageReference Include="ModelContextProtocol.AspNetCore"/>
    <PackageReference Include="Polly" />
  </ItemGroup>
    
  <ItemGroup>
    <None Remove="Kurrent.Kontext.csproj.DotSettings" />
  </ItemGroup>
    
  <ItemGroup>
    <Folder Include=".scratch\" />
    <Folder Include="Infrastructure\Data\Migrations\DuckDB\" />
    <Folder Include="Modules\Entities\" />
  </ItemGroup>

  <!-- Vendored lance build (lance-duckdb PR #237 — the stock v1.5.5 build broke the
       prefilter := true contract). Only the platform being built for is copied (~215 MB each),
       into DuckDB's own <root>/extensions/<version>/<platform>/ repository layout. -->
  <PropertyGroup>
    <!-- The publish target's RID, not the build host's. -->
    <VendoredLanceRid Condition="'$(VendoredLanceRid)' == ''">$([MSBuild]::ValueOrDefault('$(RuntimeIdentifier)', '$(NETCoreSdkPortableRuntimeIdentifier)'))</VendoredLanceRid>
    <!-- osx-arm64 -> osx_arm64, linux-x64 -> linux_amd64. DuckDBVendorExtensions must agree. -->
    <VendoredLancePlatform>$(VendoredLanceRid.Replace('-x64', '_amd64').Replace('-', '_'))</VendoredLancePlatform>
    <!-- Also composed from AppContext.BaseDirectory by DuckDBVendorExtensions. -->
    <VendoredExtensionsDir>vendor/duckdb/extensions/v$(DuckDBVersion)/$(VendoredLancePlatform)</VendoredExtensionsDir>
    <VendoredLancePath>$([MSBuild]::NormalizePath('$(RepoRoot)', '$(VendoredExtensionsDir)', 'lance.duckdb_extension'))</VendoredLancePath>
  </PropertyGroup>

  <!-- Gated on the file, so vendoring a new platform needs no change here. -->
  <ItemGroup Condition="Exists('$(VendoredLancePath)')">
    <None Include="$(VendoredLancePath)"
          LinkBase="$(VendoredExtensionsDir)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
