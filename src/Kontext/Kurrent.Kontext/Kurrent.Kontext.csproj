<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\KurrentDB.Core\KurrentDB.Core.csproj" />
    <ProjectReference Include="..\Kurrent.Kontext.Contracts\Kurrent.Kontext.Contracts.csproj" />
    <ProjectReference Include="..\Kurrent.Kontext.DuckLance\DuckLance.csproj" />
    <ProjectReference Include="..\Kurrent.Kontext.Embeddings\Kurrent.Kontext.Embeddings.csproj" />
    <ProjectReference Include="..\Kurrent.Kontext.Retrieval\Kurrent.Kontext.Retrieval.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurrent.Kontext.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNext.Threading" />
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Kurrent.Quack" />
    <PackageReference Include="Kurrent.Surge.Core" />
    <PackageReference Include="Kurrent.Surge.DuckDB" />
    <!-- Surge pulls System.Linq.Async transitively; net10's built-in System.Linq.AsyncEnumerable
         makes its operators ambiguous at compile time, so compile assets are excluded — the
         repo-wide remedy (see KurrentDB.Surge.csproj). -->
    <PackageReference Include="System.Linq.Async">
      <ExcludeAssets>compile</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="ModelContextProtocol"/>
    <PackageReference Include="ModelContextProtocol.AspNetCore"/>
    <PackageReference Include="Polly" />
  </ItemGroup>
    
  <ItemGroup>
    <None Remove="Kurrent.Kontext.csproj.DotSettings" />
  </ItemGroup>
    
  <ItemGroup>
    <Folder Include="Data\.scratch\" />
    <Folder Include="Modules\Entities\" />
  </ItemGroup>

  <!-- Vendored lance build (lance-duckdb PR #237 — the stock v1.5.5 build broke the
       prefilter := true contract). Only the platform being built for is copied (~250 MB each);
       the output path is fixed so runtime code needs no platform logic. -->
  <PropertyGroup>
    <DuckDBVersion>1.5.5</DuckDBVersion>
    <_VendoredLanceRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_VendoredLanceRid>
    <_VendoredLanceRid Condition="'$(_VendoredLanceRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_VendoredLanceRid>
    <_VendoredLancePlatform Condition="'$(_VendoredLanceRid)' == 'osx-arm64'">osx_arm64</_VendoredLancePlatform>
    <_VendoredLancePlatform Condition="'$(_VendoredLanceRid)' == 'linux-arm64'">linux_arm64</_VendoredLancePlatform>
    <_VendoredLancePlatform Condition="'$(_VendoredLanceRid)' == 'linux-x64'">linux_amd64</_VendoredLancePlatform>
  </PropertyGroup>
  <ItemGroup Condition="'$(_VendoredLancePlatform)' != ''">
    <None Include="$(MSBuildThisFileDirectory)..\..\..\vendor\duckdb\extensions\v$(DuckDBVersion)\$(_VendoredLancePlatform)\lance.duckdb_extension"
          Link="vendor\duckdb\extensions\lance.duckdb_extension"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
