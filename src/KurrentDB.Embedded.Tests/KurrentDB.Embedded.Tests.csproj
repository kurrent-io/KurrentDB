<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsKurrentTUnit>true</IsKurrentTUnit>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>KurrentDB.Embedded.Tests</RootNamespace>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="KurrentDB.Client" />
		<PackageReference Include="Shouldly" />
	</ItemGroup>

	<ItemGroup>
		<!-- BundledAssemblyReferencesTests reads what restoring KurrentDB.Embedded resolved, rather than
			 guessing at the repository layout from the test's output directory. -->
		<AssemblyMetadata Include="EmbeddedProjectAssetsFile"
						  Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\KurrentDB.Embedded\obj\project.assets.json'))" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="Shouldly" />
		<Using Include="TUnit" />
		<Using Include="TUnit.Core" />
		<Using Include="TUnit.Core.Interfaces" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\KurrentDB.Embedded\KurrentDB.Embedded.csproj" />
		<ProjectReference Include="..\KurrentDB.Testing\KurrentDB.Testing.csproj" />
		<!-- KurrentDB.Embedded references the engine with PrivateAssets="all", so that packing it does not
			 turn the bundled projects into package dependencies. That also stops them reaching anything that
			 references it, so the engine types these tests use are asked for here. -->
		<ProjectReference Include="..\KurrentDB.Hosting\KurrentDB.Hosting.csproj" />
	</ItemGroup>
</Project>
