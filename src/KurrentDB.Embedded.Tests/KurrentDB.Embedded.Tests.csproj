<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsKurrentTUnit>true</IsKurrentTUnit>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>KurrentDB.Embedded.Tests</RootNamespace>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="KurrentDB.Client" />
		<PackageReference Include="Shouldly" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="Shouldly" />
		<Using Include="TUnit" />
		<Using Include="TUnit.Core" />
		<Using Include="TUnit.Core.Interfaces" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\KurrentDB.Embedded\KurrentDB.Embedded.csproj" />
		<ProjectReference Include="..\KurrentDB.Testing\KurrentDB.Testing.csproj" />
	</ItemGroup>
</Project>
