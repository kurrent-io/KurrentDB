<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>KurrentDB.Embedded.Sample</RootNamespace>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Apache.Arrow.Flight.Sql" />
		<PackageReference Include="KurrentDB.Client" />
		<PackageReference Include="Serilog.Sinks.Console" />
	</ItemGroup>

	<!-- Plugin feature switches -->
	<ItemGroup>
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.APIV2" Value="true" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Authentication.LDAPS" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Authentication.OAUTH" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Authorization.LegacyAuthorizationWithStreamAuthorizationDisabled" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Authorization.Policy" Value="true" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.AutoScavenge" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.EncryptionAtRest" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.LogsEndpoint" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.OtlpExporter" Value="false" Trim="true" />
		<!-- SchemaRegistry is required for SecondaryIndexes -->
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.SchemaRegistry" Value="true" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.SecondaryIndexes" Value="true" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.TcpClientProtocol" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.UserCertificates" Value="false" Trim="true" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\KurrentDB.Embedded\KurrentDB.Embedded.csproj" />
	</ItemGroup>
</Project>
