<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<OutputType>Exe</OutputType>
		<ApplicationIcon>app2.ico</ApplicationIcon>
		<GenerateSupportedRuntime>false</GenerateSupportedRuntime>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<GarbageCollectionAdaptationMode>false</GarbageCollectionAdaptationMode>
	</PropertyGroup>
	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.GC.HeapHardLimitPercent" Value="60" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="KurrentDB.Components.Tests" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="BlazorMonaco" />
		<PackageReference Include="Extensions.MudBlazor.StaticInput" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" />
		<PackageReference Include="MudBlazor.Markdown" />
		<PackageReference Include="MudBlazor" />
		<PackageReference Include="SharpDotYaml.Extensions.Configuration" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\KurrentDB.Auth.Ldaps\KurrentDB.Auth.Ldaps.csproj" />
		<ProjectReference Include="..\KurrentDB.Auth.LegacyAuthorizationWithStreamAuthorizationDisabled\KurrentDB.Auth.LegacyAuthorizationWithStreamAuthorizationDisabled.csproj" />
		<ProjectReference Include="..\KurrentDB.Auth.OAuth\KurrentDB.Auth.OAuth.csproj" />
		<ProjectReference Include="..\KurrentDB.Auth.StreamPolicyPlugin\KurrentDB.Auth.StreamPolicyPlugin.csproj" />
		<ProjectReference Include="..\KurrentDB.Auth.UserCertificates\KurrentDB.Auth.UserCertificates.csproj" />
		<ProjectReference Include="..\KurrentDB.Common\KurrentDB.Common.csproj" />
		<ProjectReference Include="..\KurrentDB.Core\KurrentDB.Core.csproj" />
		<ProjectReference Include="..\KurrentDB.Diagnostics.LogsEndpointPlugin\KurrentDB.Diagnostics.LogsEndpointPlugin.csproj" />
		<ProjectReference Include="..\KurrentDB.OtlpExporterPlugin\KurrentDB.OtlpExporterPlugin.csproj" />
		<ProjectReference Include="..\KurrentDB.Projections.Management\KurrentDB.Projections.Management.csproj" />
		<ProjectReference Include="..\KurrentDB.Security.EncryptionAtRest\KurrentDB.Security.EncryptionAtRest.csproj" />
		<ProjectReference Include="..\KurrentDB.AutoScavenge\KurrentDB.AutoScavenge.csproj" />
		<ProjectReference Include="..\KurrentDB.TcpPlugin\KurrentDB.TcpPlugin.csproj" />
		<ProjectReference Include="..\KurrentDB.SecondaryIndexing\KurrentDB.SecondaryIndexing.csproj" />

        <ProjectReference Include="..\Connectors\KurrentDB.Plugins.Connectors\KurrentDB.Plugins.Connectors.csproj" />
        <ProjectReference Include="..\SchemaRegistry\KurrentDB.Plugins.SchemaRegistry\KurrentDB.Plugins.SchemaRegistry.csproj" />
        <ProjectReference Include="..\KurrentDB.Plugins.Api.V2\KurrentDB.Plugins.Api.V2.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="\">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\..\LICENSE_CONTRIBUTIONS.md" Pack="true" PackagePath="\">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\..\NOTICE.md" Pack="true" PackagePath="\">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="metricsconfig.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="kestrelsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="logconfig.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\KurrentDB.Common\Utils\version.properties">
		  <Link>version.properties</Link>
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<Content Include="app2.ico" />
		<None Remove="certs\**\*" />
		<Content Include="certs\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
	  <_ContentIncludedByDefault Remove="Components\Layout\CheckAuthorization.razor" />
	</ItemGroup>
	<!-- TODO(jen20): Investigate which of these are correct -->
	<PropertyGroup>
		<IsMac>false</IsMac>
		<IsMac Condition="('$(OS)' == 'Unix') And (Exists ('/Library/Frameworks'))">true</IsMac>
	</PropertyGroup>

	<!--
		Plugin feature switches. All plugins are enabled by default. Pass e.g. -p:EnableConnectorsPlugin=false
		to disable a plugin; with PublishTrimmed=true its code and exclusive dependencies are trimmed away.
	-->
	<ItemGroup>
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Connectors" Condition="'$(EnableConnectorsPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.SchemaRegistry" Condition="'$(EnableSchemaRegistryPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.APIV2" Condition="'$(EnableApiV2Plugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.AutoScavenge" Condition="'$(EnableAutoScavengePlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.TcpClientProtocol" Condition="'$(EnableTcpApiPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.EncryptionAtRest" Condition="'$(EnableEncryptionAtRestPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.OtlpExporter" Condition="'$(EnableOtlpExporterPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.LogsEndpoint" Condition="'$(EnableLogsEndpointPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.UserCertificates" Condition="'$(EnableUserCertificatesPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Authentication.LDAPS" Condition="'$(EnableLdapsPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Authentication.OAUTH" Condition="'$(EnableOAuthPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Authorization.LegacyAuthorizationWithStreamAuthorizationDisabled" Condition="'$(EnableLegacyAuthorizationPlugin)' == 'false'" Value="false" Trim="true" />
		<RuntimeHostConfigurationOption Include="KurrentDB.Plugins.Authorization.Policy" Condition="'$(EnableStreamPolicyPlugin)' == 'false'" Value="false" Trim="true" />
	</ItemGroup>

	<!-- Trimming removes only managed code; drop the Kafka native libraries explicitly when Connectors is disabled -->
	<Target Name="_RemoveKafkaNativeAssets" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(EnableConnectorsPlugin)' == 'false'">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'librdkafka.redist'" />
		</ItemGroup>
	</Target>

</Project>
