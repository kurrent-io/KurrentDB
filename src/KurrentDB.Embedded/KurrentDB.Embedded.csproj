<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>KurrentDB.Embedded</RootNamespace>
		<Description>Runs a single-node KurrentDB server in-process, reachable over a UNIX domain socket.</Description>
		<IsPackable>true</IsPackable>
		<IsTrimmable>true</IsTrimmable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- This is the only package we publish. Every other project in the solution is IsPackable=false,
			 so their assemblies are bundled into lib/ below rather than becoming package dependencies that
			 could never resolve. Suppressing the project reference suppresses the transitive flow of its
			 NuGet dependencies with it, so AddClosurePackageReferences below puts them back. -->
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeSolutionAssembliesInPackage</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<!-- This project's own dependencies. Everything the bundled assemblies need on top of these is
		 collected from the closure below. -->
	<ItemGroup>
		<PackageReference Include="DotNext.Threading" />
		<PackageReference Include="Grpc.Net.Client" />
		<PackageReference Include="Serilog.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<!-- The engine's json configuration, which lives with KurrentDB.Hosting but has to be packed from
			 here: a referenced project's content does not flow into this package. -->
		<None Include="..\KurrentDB.Hosting\logconfig.json" Link="logconfig.json"
			  Pack="true" PackagePath="contentFiles/any/any/" PackageCopyToOutput="true" />
		<None Include="..\KurrentDB.Hosting\metricsconfig.json" Link="metricsconfig.json"
			  Pack="true" PackagePath="contentFiles/any/any/" PackageCopyToOutput="true" />
		<None Include="..\KurrentDB.Hosting\kestrelsettings.json" Link="kestrelsettings.json"
			  Pack="true" PackagePath="contentFiles/any/any/" PackageCopyToOutput="true" />

		<!-- The promotion pipeline rewrites this file inside the package -->
		<None Include="..\KurrentDB.Common\Utils\version.properties" Link="version.properties"
			  Pack="true" PackagePath="contentFiles/any/any/" PackageCopyToOutput="true" />

		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\ouro.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE_CONTRIBUTIONS.md" Pack="true" PackagePath="\" />
		<None Include="..\..\NOTICE.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\KurrentDB.Hosting\KurrentDB.Hosting.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KurrentDB.Embedded.Tests" />
	</ItemGroup>

	<Target Name="IncludeSolutionAssembliesInPackage" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
								  Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'
											 and '%(Extension)' == '.dll'" />
		</ItemGroup>
	</Target>

	<!-- The external packages the bundled assemblies need, taken from the package references of every
		 project reachable from this one. Restore asks for them through CollectPackageReferences, so they
		 reach the assets file as ordinary references and pack turns them into package dependencies.
		 Versions come from Directory.Packages.props, as they do everywhere else. -->
	<Target Name="AddClosurePackageReferences" BeforeTargets="CollectPackageReferences">
		<MSBuild Projects="@(ProjectReference)"
				 Targets="GetClosurePackageReferences"
				 Properties="Configuration=$(Configuration)"
				 BuildInParallel="true">
			<Output TaskParameter="TargetOutputs" ItemName="_ClosurePackageReferenceCandidate" />
		</MSBuild>

		<RemoveDuplicates Inputs="@(_ClosurePackageReferenceCandidate)">
			<Output TaskParameter="Filtered" ItemName="_ClosurePackageReferenceDistinct" />
		</RemoveDuplicates>

		<!-- Exclude keeps the references this project declares itself, with their own metadata. -->
		<ItemGroup>
			<PackageReference Include="@(_ClosurePackageReferenceDistinct)"
							  Exclude="@(PackageReference)"
							  RemoveMetadata="PrivateAssets;IncludeAssets;ExcludeAssets" />
		</ItemGroup>
	</Target>
</Project>
