<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KurrentDB.Embedded</RootNamespace>
    <Description>Runs a single-node KurrentDB server in-process, reachable over a UNIX domain socket.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNext.Threading" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="KurrentDB.Client" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the node is assembled: ClusterVNodeHostedService loads every plugin and subsystem.
         Deliberately not the server executable, which would drag its Blazor UI along with it. -->
    <ProjectReference Include="..\KurrentDB.Hosting\KurrentDB.Hosting.csproj" />
  </ItemGroup>
</Project>
